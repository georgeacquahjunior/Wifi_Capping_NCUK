#
# FreeRADIUS Users File
# This file contains user definitions with authentication and authorization attributes
# Format: username Auth-Type := type, attribute = value, attribute = value
#

# Test Users for NCUK WiFi Capping System

# Student user with 5GB daily limit
student1 Cleartext-Password := "password123"
    Mikrotik-Rate-Limit = "10M/10M 20M/20M 5G/5G 300/300",
    Reply-Message = "Welcome to NCUK WiFi - Student Account",
    Session-Timeout = 28800,
    Idle-Timeout = 1800,
    Service-Type = Framed-User,
    Framed-Protocol = PPP,
    Acct-Interim-Interval = 300

# Student user with 2GB daily limit (basic plan)
student2 Cleartext-Password := "student2pass"
    Mikrotik-Rate-Limit = "5M/5M 10M/10M 2G/2G 200/200",
    Reply-Message = "Welcome to NCUK WiFi - Basic Student Account",
    Session-Timeout = 14400,
    Idle-Timeout = 1800,
    Service-Type = Framed-User,
    Framed-Protocol = PPP,
    Acct-Interim-Interval = 300

# Faculty user with 20GB daily limit
faculty1 Cleartext-Password := "faculty123"
    Mikrotik-Rate-Limit = "50M/50M 100M/100M 20G/20G 1000/1000",
    Reply-Message = "Welcome to NCUK WiFi - Faculty Account",
    Session-Timeout = 43200,
    Idle-Timeout = 3600,
    Service-Type = Framed-User,
    Framed-Protocol = PPP,
