# WiFi Capping NCUK Configuration
# Copy this file to .env and configure for your environment

# Security Configuration
SECRET_KEY=your-secret-key-here-change-this
JWT_SECRET_KEY=your-jwt-secret-key-here-change-this
ENCRYPTION_KEY=your-encryption-key-here-change-this

# Database Configuration
DATABASE_URL=sqlite:///wifi_capping.db
DATABASE_ENCRYPTION=true

# SSL/TLS Configuration
SSL_CERT_PATH=/etc/ssl/certs/wifi-capping.crt
SSL_KEY_PATH=/etc/ssl/private/wifi-capping.key
SSL_REQUIRED=true

# Network Configuration
NETWORK_INTERFACE=wlan0
MANAGEMENT_INTERFACE=eth0
MONITORING_PORT=8443

# Policy Configuration
DEFAULT_BANDWIDTH_LIMIT=10MB
DEFAULT_SESSION_TIMEOUT=3600
POLICY_ENFORCEMENT=strict

# AUP Configuration
AUP_ENABLED=true
CONTENT_FILTERING=true
AUDIT_LOGGING=true
VIOLATION_NOTIFICATION=true

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=/var/log/wifi-capping/app.log
AUDIT_LOG_FILE=/var/log/wifi-capping/audit.log