# Dictionary file for WiFi capping custom attributes
# Add custom attributes for bandwidth management and CoA functionality

# Custom vendor for NCUK WiFi capping
VENDOR      NCUK-WiFi       50001

# Custom attributes for bandwidth management
ATTRIBUTE   NCUK-Bandwidth-Limit-Up    1   integer NCUK-WiFi
ATTRIBUTE   NCUK-Bandwidth-Limit-Down  2   integer NCUK-WiFi
ATTRIBUTE   NCUK-Data-Limit-Daily      3   integer NCUK-WiFi
ATTRIBUTE   NCUK-Data-Limit-Monthly    4   integer NCUK-WiFi
ATTRIBUTE   NCUK-User-Category         5   string  NCUK-WiFi
ATTRIBUTE   NCUK-Session-Priority      6   integer NCUK-WiFi

# Values for NCUK-User-Category
VALUE       NCUK-User-Category         Student     1
VALUE       NCUK-User-Category         Staff       2
VALUE       NCUK-User-Category         Guest       3
VALUE       NCUK-User-Category         Admin       4

# Values for NCUK-Session-Priority  
VALUE       NCUK-Session-Priority      Low         1
VALUE       NCUK-Session-Priority      Normal      2
VALUE       NCUK-Session-Priority      High        3
VALUE       NCUK-Session-Priority      Critical    4

# Standard RADIUS attributes commonly used with CoA
# (These are already defined in standard dictionaries but listed for reference)

# Session management attributes
# ATTRIBUTE   Acct-Session-Id           44  string
# ATTRIBUTE   Session-Timeout           27  integer
# ATTRIBUTE   Idle-Timeout              28  integer
# ATTRIBUTE   Acct-Interim-Interval     85  integer

# Disconnect and CoA specific attributes
# ATTRIBUTE   Error-Cause               101 integer

# Values for Error-Cause (RFC 5176)
VALUE       Error-Cause                Residual-Session-Context-Removed   201
VALUE       Error-Cause                Invalid-EAP-Packet                  202
VALUE       Error-Cause                Unsupported-Attribute               401
VALUE       Error-Cause                Missing-Attribute                   402
VALUE       Error-Cause                NAS-Identification-Mismatch         403
VALUE       Error-Cause                Invalid-Request                     404
VALUE       Error-Cause                Unsupported-Service                 405
VALUE       Error-Cause                Unsupported-Extension               406
VALUE       Error-Cause                Administratively-Prohibited         501
VALUE       Error-Cause                Request-Not-Routable                502
VALUE       Error-Cause                Session-Context-Not-Found           503
VALUE       Error-Cause                Session-Context-Not-Removable       504
VALUE       Error-Cause                Other-Proxy-Processing-Error        505
VALUE       Error-Cause                Resources-Unavailable               506
VALUE       Error-Cause                Request-Initiated                   507

# Bandwidth filtering attributes (vendor specific)
# ATTRIBUTE   Filter-Id                 11  string

# Common Filter-Id values for bandwidth profiles
VALUE       Filter-Id                  bandwidth_5mbps      "5Mbps"
VALUE       Filter-Id                  bandwidth_10mbps     "10Mbps" 
VALUE       Filter-Id                  bandwidth_20mbps     "20Mbps"
VALUE       Filter-Id                  bandwidth_50mbps     "50Mbps"
VALUE       Filter-Id                  bandwidth_unlimited  "Unlimited"

# NAS-Port-Type values for WiFi identification
VALUE       NAS-Port-Type              Wireless-IEEE-802-11 19