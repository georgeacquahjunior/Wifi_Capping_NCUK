{
  "name": "wifi-capping-ncuk",
  "version": "1.0.0",
  "description": "WiFi Capping Management System for NCUK (Northern Consortium of UK Universities)",
  "main": "index.html",
  "scripts": {
    "start": "npx serve .",
    "dev": "npx serve . -p 3000",
    "build": "echo 'Build completed - static files ready for deployment'",
    "preview": "npx serve . -p 4173",
    "lint:css": "npx stylelint 'src/styles/**/*.css'",
    "format:css": "npx prettier --write 'src/styles/**/*.css'",
    "validate": "npx html-validate index.html"
  },
  "keywords": [
    "wifi",
    "bandwidth",
    "management",
    "ncuk",
    "university",
    "network",
    "dashboard",
    "css",
    "design-system"
  ],
  "author": "NCUK",
  "license": "MIT",
  "devDependencies": {
    "prettier": "^3.0.0",
    "stylelint": "^15.0.0",
    "stylelint-config-standard": "^34.0.0",
    "html-validate": "^8.0.0",
    "serve": "^14.0.0"
  },
  "prettier": {
    "semi": true,
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5"
  },
  "stylelint": {
    "extends": ["stylelint-config-standard"],
    "rules": {
      "declaration-empty-line-before": null,
      "custom-property-empty-line-before": null,
      "comment-empty-line-before": null
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/georgeacquahjunior/Wifi_Capping_NCUK"
  },
  "homepage": "https://github.com/georgeacquahjunior/Wifi_Capping_NCUK#readme",
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  }
}